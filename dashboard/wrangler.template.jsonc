// The template for wrangler.jsonc, which `make dashboard-dev` / `make dashboard-deploy`
// write with the bucket from R2_BUCKET in .env (scripts/dashboard_config.py). Not edited by
// hand: wrangler.jsonc is generated and not committed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earth-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Static files first; a path that is not one goes to the Worker (src/worker.ts).
  "assets": { "directory": "./dist" },
  // remote: `wrangler dev` reads the real bucket (make dashboard-dev); tests use a simulated one.
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "{{R2_BUCKET}}", "remote": {{REMOTE}} }],
  // Workers Logs keep the Worker's own log lines (the trigger's), but not invocation logs:
  // those record each visitor's request with its IP address and the location Cloudflare
  // derives from it (city, postal code, coordinates). The page collects neither (REQ-DASH-035).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Starts one direct round (.github/workflows/direct.yml) every 4 hours, at 00:05, 04:05, …
  // 20:05 UTC, and its daily reconcile at 00:10 UTC, after the midnight round: direct.yml has
  // no schedule of its own (DEF-052, DEF-056).
  // GITHUB_TOKEN is a secret: `npx wrangler secret put GITHUB_TOKEN`.
  "triggers": { "crons": ["5 */4 * * *", "10 0 * * *"] },
  "vars": { "GITHUB_API": "https://api.github.com", "GITHUB_REPO": "dienarvaez1/earth-hub" }
}

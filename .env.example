# Copy to .env and set local values. Never commit .env.
#
# These values are for code running on your machine (tests, scripts, the API in dev).
# Containers started by docker-compose.yml get their in-network host names
# (postgres, kafka:9092) from the compose file instead.

APP_NAME=Earth-Hub
APP_ENV=development
API_PORT=8000

# PostgreSQL. config.py builds the connection URL from these parts,
# so the password is defined only once. POSTGRES_PORT is also the host port
# docker-compose.yml publishes (5432 is often taken by a local PostgreSQL).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=earth_hub
POSTGRES_USER=earth_hub_app
POSTGRES_PASSWORD=change_me_locally

# Kafka. 29092 is the listener published to the host. Use 127.0.0.1, not localhost:
# localhost may resolve to IPv6 ::1 first, where nothing is listening.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092
KAFKA_TOPIC_RAW=earthquakes.raw

# USGS feed. The poller times requests from the feed's cache headers;
# POLL_INTERVAL_SECONDS is the fallback when those headers are missing.
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
POLL_INTERVAL_SECONDS=60

# Backfill and catch-up publish to their own topic, read by a separate consumer.
KAFKA_TOPIC_BACKFILL=earthquakes.backfill
# Messages per transaction for consumer-backfill (the live consumer runs one at a time).
CONSUMER_BATCH_SIZE=500
# Pause between requests to the USGS FDSN API, to be gentle on it (seconds).
FDSN_PAUSE_SECONDS=1.0
CATCHUP_INTERVAL_SECONDS=3600
DELETED_CHECK_INTERVAL_SECONDS=86400
# Contact added to the User-Agent sent to USGS, so they can reach the operator.
USGS_CONTACT=https://github.com/dienarvaez1/earth-hub

# On-demand export of the earthquakes table to Cloudflare R2: make export-r2.
# Create an R2 API token with Object Read & Write on the bucket; never commit real values.
EXPORT_API_URL=http://127.0.0.1:8000/api/v1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: another S3-compatible endpoint instead of https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Uploads in flight at once (1-256). A first full export of ~115,000 rows took about
# 98 minutes at 16; later runs upload only changes.
EXPORT_WORKERS=64

# Copy to .env and set local values. Never commit .env.

APP_NAME=Earth-Hub
APP_ENV=development
API_PORT=8000

# PostgreSQL. config.py builds the connection URL from these parts,
# so the password is defined only once.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=earth_hub
POSTGRES_USER=earth_hub_app
POSTGRES_PASSWORD=change_me_locally

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=earthquakes.raw

# USGS feed. The poller times requests from the feed's cache headers;
# POLL_INTERVAL_SECONDS is the fallback when those headers are missing.
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
POLL_INTERVAL_SECONDS=60

# Host names above work inside the Docker network. Tools running on your
# machine connect through localhost and the ports published in docker-compose.yml.
